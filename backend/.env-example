NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Lokal: 127.0.0.1 (Laragon). Di Docker Compose di-override jadi host.docker.internal.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=myunand_kurikulum_new
DB_USER=root
DB_PASS=

JWT_SECRET=myunand_kurikulum_jwt_secret_key_2026
JWT_EXPIRES_IN=20m
JWT_REFRESH_EXPIRES_IN=7d

APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:8080

# Redis (lokal: docker compose up -d redis). Backend tetap jalan jika Redis down.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
